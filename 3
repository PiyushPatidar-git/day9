#include<iostream>
using namespace std;
int main(){
    int num;
    cout<<"enter the no.";
    cin>>num;
    while(num>9){
        int ans = 0;
        while(num>0){
            int rem = num%10;
            num = num/10;
            ans = rem + ans;
        }
        num = ans;
    }
    cout<<num;
}
